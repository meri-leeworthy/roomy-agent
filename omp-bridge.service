[Unit]
Description=Roomy -> omp agent bridge (Chanterelle) — full pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/roomy-agent
ExecStart=/home/exedev/roomy-agent/run-agent.sh
Restart=always
RestartSec=5
# run-agent.sh sources OLLAMA_CLOUD_API_KEY from ~/.omp/agent/ollama-cloud.env
Environment=PI_CODING_AGENT_DIR=/home/exedev/.omp/agent

[Install]
WantedBy=multi-user.target
