[Unit]
Description=Roomy -> agent bridge (emit side)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/roomy-agent
ExecStart=/home/exedev/roomy-agent/run-omp-bridge.sh
Restart=always
RestartSec=5
# The runner script sources OLLAMA_CLOUD_API_KEY from ~/.omp/agent/ollama-cloud.env
Environment=OMP_SYSTEM_PROMPT_FILE=/home/exedev/.omp/workflow-context.md

[Install]
WantedBy=multi-user.target
