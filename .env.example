# Roomy app-password credentials (required)
ATPROTO_IDENTIFIER=handle.or.did
ATPROTO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Appserver (defaults: http://localhost:8080 / did:web:api.roomy.space)
APPSERVER_URL=https://api.roomy.space
APPSERVER_DID=did:web:api.roomy.space

# Optional: comma-separated DIDs allowed to trigger responses
OMP_BRIDGE_AUTHORIZED_DIDS=
